# ─── Base de données : PostgreSQL (Neon) ─────────────────────────────────────
# Récupère les deux chaînes dans le dashboard Neon (bouton "Connect", Prisma).
# DATABASE_URL : connexion avec pool (l'hôte contient "-pooler").
# DIRECT_URL   : connexion directe (sans "-pooler"), pour `prisma db push`.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/salle?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/salle?sslmode=require"

# ─── FeexPay (Mobile Money) ──────────────────────────────────────────────────
FEEXPAY_API_KEY="votre_cle_api_feexpay"
FEEXPAY_SHOP_ID="votre_shop_id_feexpay"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
